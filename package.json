{
  "name": "tech-demo-director",
  "version": "1.0.0",
  "description": "Tech demo scripting skill + companion CLI for AI coding tools",
  "type": "module",
  "bin": {
    "demo-director": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "compiled",
    "contributions",
    "docs",
    "site",
    "README.md",
    "LICENSE",
    "install.sh",
    "install.ps1"
  ],
  "scripts": {
    "smoke": "node dist/cli/index.js --help >/dev/null",
    "test": "npm run smoke",
    "setup": "bash install.sh",
    "setup:all": "bash install.sh --all",
    "install-skills": "bash install.sh --skills-only",
    "uninstall-skills": "bash install.sh --uninstall"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
